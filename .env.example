# Pharos Atlantic Testnet x402 Configuration
PORT=4021
NODE_ENV=development

# Network Configuration
NETWORK_ID=eip155:688689
CHAIN_ID=688689
RPC_URL=https://atlantic.dplabs-internal.com
EXPLORER_URL=https://atlantic.pharosscan.com

# Verified Atlantic Testnet USDC
USDC_ADDRESS=0xcfC8330f4BCAB529c625D12781b1C19466A9Fc8B
USDC_NAME=USDC

# Seller / API Recipient Address (where payments are transferred)
PAY_TO_ADDRESS=0x0000000000000000000000000000000000000000

# Facilitator Configuration
FACILITATOR_URL=http://localhost:4021

# Facilitator Settlement Signer Private Key (64-char hex with 0x prefix)
# Used exclusively server-side to submit on-chain settlements
FACILITATOR_PRIVATE_KEY=0x_your_facilitator_private_key_here

# Client Private Key (for client CLI testing only; browser demo uses injected or prompt)
CLIENT_PRIVATE_KEY=0x_your_client_private_key_here
